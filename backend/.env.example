# Dateza backend environment template. Copy to `.env` (git-ignored) for local development.
# On Render set these in the dashboard / render.yaml. NEVER commit real values.

# --- Required ---
# PostgreSQL connection string (Neon: include ?sslmode=require)
DATABASE_URL=postgresql://user:password@localhost:5432/dateza
# Long random string, at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# --- Server ---
PORT=3000
# Web origin(s) allowed to call the API / open sockets, comma separated. Required in production.
CORS_ORIGIN=http://localhost:8081
# NODE_ENV=production   (Render sets RENDER=true, which also counts as production)

# --- Optional ---
# Live Demo accounts (Alex / Elena). Off unless "true".
DEMO_LOGIN_ENABLED=false
# Session lifetimes in days
# WEB_SESSION_DAYS=7
# NATIVE_SESSION_DAYS=30
# Email for verification codes and password reset (https://resend.com). Without both, these
# features are disabled in production and codes are only logged in development.
# RESEND_API_KEY=
# MAIL_FROM="Dateza <no-reply@your-verified-domain.com>"
# Google sign-in (native). Without a client ID the endpoints answer 503.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Development only: a fake Google account chooser that signs in as ANY email. Ignored in production.
# ALLOW_MOCK_GOOGLE_LOGIN=true
# LOG_LEVEL=info
# PG_POOL_MAX=10
