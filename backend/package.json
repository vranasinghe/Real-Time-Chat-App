{
  "name": "dateza-backend",
  "version": "1.0.0",
  "description": "Custom Node.js and PostgreSQL backend for Dateza Dating App",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/session.test.js test/units.test.js test/showcase.test.js test/dbSafety.test.js test/demoConfig.test.js test/demoSession.test.js test/age.test.js test/eligibility.test.js test/oauth.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "test:session": "node --test test/session.test.js",
    "test:chat": "node test/chat.e2e.js",
    "test:images": "node test/images.e2e.js",
    "images:import": "node scripts/import-images.js",
    "test:integration:local": "node scripts/run-integration.js",
    "test:e2e:local": "node scripts/run-e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
