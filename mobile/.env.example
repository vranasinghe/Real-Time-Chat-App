# Dateza mobile / web environment template. Copy to `.env` (git-ignored).
# EXPO_PUBLIC_* values are inlined at BUILD time and are visible to anyone who has the
# app. NEVER put secrets (database URL, JWT secret, service keys) in them.

# Backend origin. Required for production builds (no fallback there).
# Development: http://localhost:3000   (Android emulator is mapped to 10.0.2.2 automatically)
# Production:  https://real-time-chat-app-qsrn.onrender.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Web only (optional). Where the browser sends REST calls.
#   unset in production -> same origin ("/api/..."), proxied by Vercel (see vercel.json)
#   unset in development -> EXPO_PUBLIC_BACKEND_URL (set CORS_ORIGIN=http://localhost:8081 on the backend, or leave it unset in dev)
# EXPO_PUBLIC_WEB_API_BASE=
