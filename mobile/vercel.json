{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "EXPO_PUBLIC_BACKEND_URL": "https://real-time-chat-app-qsrn.onrender.com"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://real-time-chat-app-qsrn.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
